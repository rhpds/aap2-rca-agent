{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Analysis Summary",
  "description": "Root cause summary from correlation analysis with AgnosticD/V configuration context",
  "type": "object",
  "required": ["job_id", "root_cause", "correlation", "evidence"],
  "properties": {
    "job_id": {
      "type": "string"
    },
    "analyzed_at": {
      "type": "string",
      "format": "date-time"
    },
    "root_cause": {
      "type": "object",
      "required": ["summary", "category", "confidence"],
      "properties": {
        "summary": {
          "type": "string",
          "description": "One-line description of the root cause"
        },
        "category": {
          "type": "string",
          "enum": [
            "application_bug",
            "infrastructure",
            "configuration",
            "dependency",
            "network",
            "resource",
            "cloud_api",
            "secrets",
            "unknown"
          ]
        },
        "confidence": {
          "type": "string",
          "enum": ["high", "medium", "low"]
        }
      }
    },
    "correlation": {
      "type": "object",
      "required": ["method", "identifiers"],
      "properties": {
        "method": {
          "type": "string",
          "description": "How AAP job was correlated to Splunk logs"
        },
        "identifiers": {
          "type": "object",
          "properties": {
            "guid": {"type": "string"},
            "namespace": {"type": "string"},
            "pod_name": {"type": "string"}
          }
        },
        "time_overlap": {
          "type": "object",
          "properties": {
            "aap_job_start": {"type": "string"},
            "aap_job_end": {"type": "string"},
            "splunk_first_error": {"type": "string"},
            "splunk_last_error": {"type": "string"},
            "overlap_confirmed": {"type": "boolean"}
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source", "timestamp", "message"],
        "properties": {
          "source": {
            "type": "string",
            "enum": ["aap_job", "splunk_ocp", "agnosticv_config", "agnosticd_code"]
          },
          "timestamp": {"type": "string"},
          "message": {"type": "string"},
          "github_path": {
            "type": "string",
            "description": "REQUIRED when source is agnosticv_config or agnosticd_code. Format: 'owner/repo:path/to/file.yml:line' (e.g., 'rhpds/agnosticv:openshift_cnv/account.yaml' or 'agnosticd/core_workloads:roles/ROLE/tasks/file.yml:123'). Extract from step4 github_fetches[].location.parsed or fetched_configs/fetched_workload paths."
          }
        }
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "priority": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          },
          "action": {"type": "string"},
          "github_path": {
            "type": "string",
            "description": "GitHub path reference in format 'owner/repo:path/to/file.yml:line' (e.g., 'rhpds/agnosticv:openshift_cnv/account.yaml:42'). Extract from step4 data."
          },
          "details": {"type": "string"},
          "evidence_ref": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "0-based index into this file's evidence[] array that this recommendation addresses"
          },
          "fix": {
            "description": "null unless a concrete, model-authored patch is proposed. Never set without both status and base_sha.",
            "type": ["object", "null"],
            "additionalProperties": false,
            "required": ["status", "base_sha"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["proposed"],
                "description": "Always 'proposed' here -- model-authored, untested"
              },
              "base_sha": {
                "type": "string",
                "description": "The 'sha' of the fetched file this diff applies to, from step4_github_fetch_history.json's fetched_configs/fetched_workload"
              },
              "diff": {"type": ["string", "null"], "description": "Unified diff against the file at base_sha"},
              "pr_link": {"type": ["string", "null"]}
            }
          }
        }
      }
    },
    "causal_chain": {
      "type": "array",
      "description": "Ordered account of how the failure unfolded -- the direct cause(s) and any contributing factors, each tied back to an evidence entry",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "relationship", "statement"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "relationship": {
            "type": "string",
            "enum": ["direct_cause", "contributing_factor"]
          },
          "statement": {"type": "string"},
          "evidence_ref": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "0-based index into this file's evidence[] array that supports this step"
          }
        }
      }
    },
    "misidentifications": {
      "type": "array",
      "description": "Theories considered and ruled out during the investigation -- only include genuine dead ends, not a list of everything checked",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["theory", "why_suspected", "why_ruled_out"],
        "properties": {
          "theory": {"type": "string"},
          "why_suspected": {"type": "string"},
          "why_ruled_out": {"type": "string"},
          "evidence_ref": {
            "type": ["integer", "null"],
            "minimum": 0,
            "description": "0-based index into this file's evidence[] array that ruled this theory out"
          }
        }
      }
    }
  }
}
