# Environment for `rca-analyze cost` (src/rca/analysis/cost_estimate.py)
# Copy the lines you need into your shell or secret store. Do not commit real values.

# Required. Access token for the reporting-db-prod MCP server (read-only SQL gateway).
# Get one from the RHDP reporting platform team.
export REPORTING_MCP_TOKEN=<your-mcp-access-token>

# Optional. Defaults to the production reporting MCP endpoint.
# export REPORTING_MCP_URL=https://<reporting-mcp-host>/mcp/
