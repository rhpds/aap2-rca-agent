# Single source of CI configuration. Loaded into $GITHUB_ENV by
# batch-cronjob.yml and sourced by setup-namespace.sh. Plain KEY=value lines
# only (no quotes, no inline comments). CI throwaway values only; real secrets
# stay in GitHub secrets or the cluster.

# Kubernetes object names
POSTGRES_NAME=rca-ci-postgres
JUMPBOX_NAME=rca-ci-jumpbox
JUMPBOX_KEY_SECRET=rca-ci-jumpbox-key
JOB_NAME=rca-ci-cronjob-run
WORKSPACE_POD=rca-ci-workspace
RELEASE=rca-ci-cron
LITELLM_SECRET=claude-litellm-creds

# CI jumpbox
JUMPBOX_PORT=2222
JUMPBOX_USER=testuser

# CI Postgres
DB_NAME=rca_test
DB_USER=rca_test
DB_PASSWORD=rca_test
DB_PORT=5432
DB_TABLE=aap2_events
DB_RESULT_TABLE=aap2_job_results
# Local end of the CronJob's SSH tunnel; fixed in deploy/helm/templates/cronjob.yaml
DB_TUNNEL_PORT=15432

# Paths on the chart PVC
LOGS_DIR=/workspace/synthetic-logs
STATE_DIR=/workspace/.rca

# Batch run
CLAUDE_MODEL=claude-sonnet-4-6
MAX_PARALLEL_JOBS=5
